{
  "name": "@troyargonauts/2026-scouting-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/ vite.config.ts",
    "protobuf": "pbjs -t static-module -w es6 -o src/protobuf/match-record.js src/protobuf/match-record.proto && pbts -o src/protobuf/match-record.d.ts src/protobuf/match-record.js"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@vueuse/core": "^12.5.0",
    "html5-qrcode": "2.3.8",
    "qrcode": "^1.5.4",
    "vite-plugin-vuetify": "^2.1.0",
    "vue": "^3.5.13",
    "vuetify": "^3.7.8"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.3.3",
    "protobufjs": "^7.4.0",
    "protobufjs-cli": "^1.1.3",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.1.10"
  }
}

